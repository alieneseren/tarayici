/*
  Visionary Navigator — Safari macOS Light Theme
  Apple Safari'nin aydınlık, minimal tasarım dili.
  Renk paleti: Apple Human Interface Guidelines (Light Mode)
*/

/* ━━━━ Global ─────────────────────────────────────────────────── */
QMainWindow {
    background-color: #FFFFFF;
    color: #1C1C1E;
}

QWidget {
    background-color: transparent;
    color: #1C1C1E;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* ━━━━ Toolbar — Safari macOS Light ──────────────────────────── */
QToolBar {
    background: rgba(242, 242, 247, 0.96);
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 6px 12px;
    spacing: 4px;
}

QToolBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
    color: rgba(60, 60, 67, 0.7);
    font-size: 13px;
}

QToolBar QToolButton:hover {
    background: rgba(0, 0, 0, 0.06);
    color: #1C1C1E;
}

QToolBar QToolButton:pressed {
    background: rgba(0, 0, 0, 0.10);
}

/* ━━━━ Nav Buttons (sfNavBtn) ─────────────────────────────────── */
QPushButton#sfNavBtn {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 4px;
    color: rgba(60, 60, 67, 0.55);
}

QPushButton#sfNavBtn:hover {
    background: rgba(0, 0, 0, 0.07);
    color: #1C1C1E;
}

QPushButton#sfNavBtn:pressed {
    background: rgba(0, 0, 0, 0.12);
}

QPushButton#sfNavBtn:disabled {
    color: rgba(60, 60, 67, 0.20);
}

/* ━━━━ Address Pill Container ─────────────────────────────────── */
QWidget#addressPill {
    background: rgba(118, 118, 128, 0.12);
    border: 1px solid transparent;
    border-radius: 10px;
    min-height: 36px;
    max-height: 36px;
}

QWidget#addressPill:focus-within {
    background: #FFFFFF;
    border: 1.5px solid rgba(0, 122, 255, 0.50);
}

/* ━━━━ Address Bar (input) ────────────────────────────────────── */
QLineEdit#addressBar {
    background: transparent;
    border: none;
    color: #1C1C1E;
    font-size: 13.5px;
    selection-background-color: rgba(0, 122, 255, 0.22);
    selection-color: #1C1C1E;
    padding: 0;
}

QLineEdit#addressBar:focus {
    background: transparent;
    border: none;
}

/* ━━━━ Lock Icon ──────────────────────────────────────────────── */
QLabel#lockIcon {
    color: rgba(60, 60, 67, 0.55);
    font-size: 12px;
    background: transparent;
    padding: 0;
}

/* ━━━━ Inline Reload Button ───────────────────────────────────── */
QPushButton#reloadInlineBtn {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 2px;
    color: rgba(60, 60, 67, 0.55);
}

QPushButton#reloadInlineBtn:hover {
    background: rgba(0, 0, 0, 0.07);
    color: #1C1C1E;
}

/* ━━━━ Tabs — Safari Style ────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: #FFFFFF;
}

QTabBar {
    background-color: rgba(242, 242, 247, 0.96);
    border: none;
}

QTabBar::tab {
    background: transparent;
    color: rgba(60, 60, 67, 0.60);
    border: none;
    border-radius: 7px;
    padding: 5px 14px;
    margin: 4px 2px;
    min-width: 90px;
    max-width: 200px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #1C1C1E;
    border: none;
}

QTabBar::tab:hover:!selected {
    background: rgba(0, 0, 0, 0.05);
    color: #1C1C1E;
}

QTabBar::close-button {
    image: url('/Users/alienes/kendi_tarayicim/assets/icons/close.svg');
    background-color: transparent;
    border-radius: 3px;
    margin: 1px;
}

QTabBar::close-button:hover {
    background-color: rgba(255, 59, 48, 0.12);
}

/* ━━━━ + Tab Button ───────────────────────────────────────────── */
QPushButton#newTabBtn {
    background: transparent;
    color: rgba(60, 60, 67, 0.55);
    border: none;
    border-radius: 7px;
    font-size: 16px;
    font-weight: 400;
}

QPushButton#newTabBtn:hover {
    background: rgba(0, 0, 0, 0.06);
    color: #1C1C1E;
}

/* ━━━━ Floating Islands (AI Sidebar & AR) ─────────────────────── */
QWidget#aiSidebar, QWidget#arWidget {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 14px;
}

QLabel#sidebarTitle {
    font-size: 12px;
    font-weight: 700;
    color: #1C1C1E;
    letter-spacing: 0.3px;
}

QTextEdit#aiOutput {
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 8px;
    padding: 12px;
    color: #1C1C1E;
    font-size: 13px;
    line-height: 1.5;
}

/* ━━━━ Panel Buttons ──────────────────────────────────────────── */
QWidget#aiSidebar QPushButton,
QWidget#arWidget QPushButton,
QWidget#settingsPage QPushButton,
QWidget#settingsInner QPushButton {
    background: rgba(0, 0, 0, 0.05);
    color: #1C1C1E;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 500;
    font-size: 12px;
}

QWidget#aiSidebar QPushButton:hover,
QWidget#arWidget QPushButton:hover,
QWidget#settingsPage QPushButton:hover {
    background: rgba(0, 0, 0, 0.09);
    border-color: rgba(0, 0, 0, 0.12);
}

QWidget#aiSidebar QPushButton:pressed,
QWidget#arWidget QPushButton:pressed,
QWidget#settingsPage QPushButton:pressed {
    background: rgba(0, 0, 0, 0.04);
}

QPushButton:disabled {
    color: rgba(60, 60, 67, 0.25);
    background: transparent;
    border-color: rgba(0, 0, 0, 0.04);
}

QPushButton#accentButton {
    background: rgba(0, 122, 255, 0.10);
    color: #007AFF;
    border: 1px solid rgba(0, 122, 255, 0.22);
    font-weight: 500;
    border-radius: 8px;
    padding: 6px 14px;
}

QPushButton#accentButton:hover {
    background: rgba(0, 122, 255, 0.18);
    color: #0062CC;
    border-color: rgba(0, 122, 255, 0.42);
}

/* ━━━━ Scrollbars ─────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.14);
    border-radius: 2px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0, 0, 0, 0.24);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

/* ━━━━ Status Bar ─────────────────────────────────────────────── */
QStatusBar {
    background: rgba(242, 242, 247, 0.96);
    border-top: 1px solid rgba(0, 0, 0, 0.07);
    color: rgba(60, 60, 67, 0.55);
    font-size: 11px;
    padding: 2px 8px;
}

/* ━━━━ Progress Bar ───────────────────────────────────────────── */
QProgressBar {
    background: rgba(0, 0, 0, 0.04);
    border: none;
    border-radius: 1px;
    height: 2px;
    color: transparent;
}

QProgressBar::chunk {
    background: #007AFF;
    border-radius: 1px;
}

/* ━━━━ Separator ──────────────────────────────────────────────── */
QToolBar::separator {
    background: rgba(0, 0, 0, 0.08);
    width: 1px;
    margin: 5px 3px;
}

/* ━━━━ Message Box ────────────────────────────────────────────── */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1C1C1E;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QMessageBox QPushButton {
    background: rgba(0, 0, 0, 0.05);
    color: #1C1C1E;
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 80px;
    font-weight: 600;
}

QMessageBox QPushButton:hover {
    background: rgba(0, 0, 0, 0.09);
}

/* ━━━━ Tooltip ────────────────────────────────────────────────── */
QToolTip {
    background: #FFFFFF;
    color: #1C1C1E;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 12px;
}
