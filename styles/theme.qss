/*
  Visionary Navigator — Safari macOS Dark Mode
  Apple macOS dark palette with SF-style clean design.
*/

/* ── Global ───────────────────────────────────────── */
QMainWindow {
    background-color: #1C1C1E;
    color: #EBEBF5;
}

QWidget {
    background-color: transparent;
    color: #EBEBF5;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* ── Toolbar — Safari macOS ───────────────────────── */
QToolBar {
    background: #1C1C1E;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 7px 12px;
    spacing: 4px;
}

QToolBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
    color: #8E8EA0;
    font-size: 13px;
}

QToolBar QToolButton:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #EBEBF5;
}

/* ── Safari Nav Buttons (sfNavBtn) ────────────────── */
QPushButton#sfNavBtn {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 4px;
    color: #8E8EA0;
}

QPushButton#sfNavBtn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #EBEBF5;
}

QPushButton#sfNavBtn:pressed {
    background: rgba(255, 255, 255, 0.13);
}

QPushButton#sfNavBtn:disabled {
    color: rgba(142, 142, 160, 0.3);
}

/* ── Address Pill Container ───────────────────────── */
QWidget#addressPill {
    background: #2C2C2E;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    min-height: 36px;
    max-height: 36px;
}

QWidget#addressPill:focus-within {
    background: #3A3A3C;
    border: 1.5px solid rgba(10, 132, 255, 0.45);
}

/* ── Address Bar (input inside pill) ─────────────── */
QLineEdit#addressBar {
    background: transparent;
    border: none;
    color: #EBEBF5;
    font-size: 13.5px;
    selection-background-color: rgba(10, 132, 255, 0.35);
    selection-color: #FFFFFF;
    padding: 0;
}

QLineEdit#addressBar:focus {
    background: transparent;
    border: none;
}

/* ── Lock Icon ────────────────────────────────────── */
QLabel#lockIcon {
    color: #8E8EA0;
    font-size: 12px;
    background: transparent;
    padding: 0;
}

/* ── Inline Reload Button ─────────────────────────── */
QPushButton#reloadInlineBtn {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 2px;
    color: #8E8EA0;
}

QPushButton#reloadInlineBtn:hover {
    background: rgba(255, 255, 255, 0.10);
    color: #EBEBF5;
}

/* ── Tabs — Safari Style ──────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: #1C1C1E;
}

QTabBar {
    background-color: #1C1C1E;
    border: none;
}

QTabBar::tab {
    background: transparent;
    color: #8E8EA0;
    border: none;
    border-radius: 7px;
    padding: 5px 14px;
    margin: 4px 2px;
    min-width: 90px;
    max-width: 200px;
    font-size: 12px;
    font-weight: 500;
}


QTabBar::tab:selected {
    background: #2C2C2E;
    color: #EBEBF5;
    border: none;
}

QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.05);
    color: #EBEBF5;
}

QTabBar::close-button {
    image: url('/Users/alienes/kendi_tarayicim/assets/icons/close.svg');
    background-color: transparent;
    border-radius: 3px;
    margin: 1px;
}

QTabBar::close-button:hover {
    background-color: rgba(255, 82, 82, 0.7);
}

/* ── + Tab Button ─────────────────────────────────── */
QPushButton#newTabBtn {
    background: transparent;
    color: #8E8EA0;
    border: none;
    border-radius: 7px;
    font-size: 16px;
    font-weight: 500;
}

QPushButton#newTabBtn:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #EBEBF5;
}

/* ── Floating Islands (AI Sidebar & AR) ───────────── */
QWidget#aiSidebar, QWidget#arWidget {
    background: #1C1C1E;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
}

QLabel#sidebarTitle {
    font-size: 12px;
    font-weight: 700;
    color: #EBEBF5;
    letter-spacing: 0.5px;
}

QTextEdit#aiOutput {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 12px;
    color: #EBEBF5;
    font-size: 13px;
    line-height: 1.5;
}

/* ── Buttons (scoped to panels) ─────────────── */
QWidget#aiSidebar QPushButton,
QWidget#arWidget QPushButton,
QWidget#settingsPage QPushButton,
QWidget#settingsInner QPushButton {
    background: rgba(255, 255, 255, 0.06);
    color: #EBEBF5;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 500;
    font-size: 12px;
}

QWidget#aiSidebar QPushButton:hover,
QWidget#arWidget QPushButton:hover,
QWidget#settingsPage QPushButton:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.14);
}

QWidget#aiSidebar QPushButton:pressed,
QWidget#arWidget QPushButton:pressed,
QWidget#settingsPage QPushButton:pressed {
    background: rgba(255, 255, 255, 0.04);
}

QPushButton:disabled {
    color: rgba(235, 235, 245, 0.20);
    background: transparent;
    border-color: rgba(255, 255, 255, 0.04);
}

QPushButton#accentButton {
    background: rgba(10, 132, 255, 0.14);
    color: #0A84FF;
    border: 1px solid rgba(10, 132, 255, 0.25);
    font-weight: 500;
    border-radius: 8px;
    padding: 6px 14px;
}

QPushButton#accentButton:hover {
    background: rgba(10, 132, 255, 0.22);
    color: #FFFFFF;
    border-color: rgba(10, 132, 255, 0.50);
}

/* ── Scrollbars — Subtle ──────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.22);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

/* ── Status Bar ─────────────────────────────────── */
QStatusBar {
    background: #1C1C1E;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #8E8EA0;
    font-size: 11px;
    padding: 2px 8px;
}

/* ── Progress Bar ─────────────────────────────────── */
QProgressBar {
    background: rgba(255, 255, 255, 0.04);
    border: none;
    border-radius: 1px;
    height: 2px;
    color: transparent;
}

QProgressBar::chunk {
    background: #0A84FF;
    border-radius: 1px;
}

/* ── Separator ────────────────────────────────────── */
QToolBar::separator {
    background: rgba(255, 255, 255, 0.06);
    width: 1px;
    margin: 5px 3px;
}

/* ── Popups & Tooltips ─────────────────────────────── */
QMessageBox {
    background-color: #2C2C2E;
}

QMessageBox QLabel {
    color: #EBEBF5;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QMessageBox QPushButton {
    background: #3A3A3C;
    color: #EBEBF5;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 80px;
    font-weight: 600;
}

QMessageBox QPushButton:hover {
    background: #48484A;
}

QToolTip {
    background: #2C2C2E;
    color: #EBEBF5;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 12px;
}
